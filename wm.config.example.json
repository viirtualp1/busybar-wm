{
  "apps": [
    {
      "name": "livesplit",
      "cwd": "../busybar-livesplit",
      "command": "npm",
      "args": ["start"],
      "autostart": false
    },
    {
      "name": "dota",
      "cwd": "../busybar-dota",
      "command": "npm",
      "args": ["start"],
      "restart": true
    },
    {
      "name": "chess",
      "cwd": "../busybar-chess",
      "command": "npm",
      "args": ["start"]
    },
    {
      "name": "nowplaying",
      "cwd": "../busybar-nowplaying",
      "command": "npm",
      "args": ["start"],
      "env": {
        "INPUT": "1"
      }
    }
  ]
}
