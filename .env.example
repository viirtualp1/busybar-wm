# --- The Bar itself ----------------------------------------------------------
# Only the daemon needs these. The apps behind it are handed a BUSY_ADDR that
# points at this process, and their own credentials are replaced on the way out.
# USB (default): nothing to set, the Bar answers on 10.0.4.20
# Wi-Fi: the Bar's IP plus the HTTP Access password from its web UI
# Cloud: https://api.busy.app plus a token
BUSY_ADDR=
BUSY_HTTP_PASSWORD=
BUSY_TOKEN=

# --- Where the apps find "the Bar" -------------------------------------------
WM_HOST=127.0.0.1
WM_PORT=4111

# Which manifest to read, when none is named on the command line.
WM_CONFIG=wm.config.json

# A directory holding a whole setup: the manifest, the apps as installed
# packages, and a folder per app for its own .env and data files. With one set,
# a manifest entry can be nothing but a name — the app is the package installed
# here, and its config lives in <profile>/<name>/. Same as `--profile <dir>`.
# Leave it empty to keep pointing the manifest at checkouts by path.
# WM_PROFILE=~/.busybar

# --- Policy ------------------------------------------------------------------
# The shortest a frame may stay before an equal-ranked app can take the screen.
# Higher rank always interrupts immediately; this only stops two apps of the
# same rank from trading the display every frame.
WM_MIN_HOLD_MS=3000

# How long an app chosen with the OK button stays chosen. 0 keeps it until BACK.
WM_PIN_MS=60000

# How often the clock-driven half of the policy is re-checked.
WM_TICK_MS=1000

# How long an app started by hand — one with no manifest command — is believed
# after its last draw. Supervised apps do not need this: their process is the
# proof. Ten minutes by default, because apps redraw only when something
# changed, and a static frame is not a dead one.
WM_STALE_MS=600000

# Backoff base for restarting an app that exited. Doubles per consecutive failure.
WM_RESTART_MS=2000

REQUEST_TIMEOUT_MS=10000

# --- The Bar's own controls --------------------------------------------------
# OK steps to the next app that has something to show, BACK goes back to
# automatic. Set to 0 to leave the buttons entirely to the apps.
WM_INPUT=1

# Let the knob switch apps too. Off by default: apps bind it themselves —
# busybar-nowplaying makes it the system volume — and this would fight them.
WM_KNOB=0
